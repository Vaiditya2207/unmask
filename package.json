{
  "name": "@xagents_in/unmask",
  "version": "0.1.1",
  "private": false,
  "description": "Evidence-based comparison of npm packages and their source archives",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaiditya2207/unmask.git"
  },
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/tooling/*.test.mjs tests/product/*.test.mjs",
    "test:product": "node --test tests/product/*.test.mjs",
    "check:package": "node scripts/check-package.mjs --build",
    "test:release": "node scripts/smoke-candidate.mjs",
    "release:readiness": "node scripts/release-readiness.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "unmask": "dist/cli/main.mjs"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "tar-stream": "3.2.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
