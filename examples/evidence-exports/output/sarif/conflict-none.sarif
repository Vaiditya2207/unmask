{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "unmask",
          "version": "0.0.0",
          "informationUri": "https://github.com/Vaiditya2207/unmask",
          "rules": [
            {
              "id": "cue/manifest-artifact-runtime-observation",
              "name": "cueManifestArtifactRuntimeObservation",
              "shortDescription": {
                "text": "Analyzer review cue; behavior is not proven."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "cue"
                ]
              }
            },
            {
              "id": "policy/identity-claim-conflict",
              "name": "policyIdentityClaimConflict",
              "shortDescription": {
                "text": "Artifact manifest identity differs from the claimed package identity."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "ARTIFACT_ROOT": {
          "description": {
            "text": "Root of the analyzed npm artifact after removing its archive prefix."
          }
        },
        "SOURCE_ROOT": {
          "description": {
            "text": "Root of the selected source archive after removing its archive prefix."
          }
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "descriptor": {
                "id": "coverage/source-unavailable"
              },
              "level": "warning",
              "message": {
                "text": "No source archive was compared; artifact files have no source correspondence."
              }
            },
            {
              "descriptor": {
                "id": "coverage/unresolved-files"
              },
              "level": "note",
              "message": {
                "text": "4 of 4 artifact files are not byte-identical to selected source (4 not compared)."
              }
            },
            {
              "descriptor": {
                "id": "limitation/absence-not-safety"
              },
              "level": "note",
              "message": {
                "text": "Absence of results does not establish that the package is safe; only recorded evidence, deterministic policy rules and the supplied advisory snapshot are reported."
              }
            }
          ]
        }
      ],
      "results": [
